# 1) Forçar HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2) Padronizar www para não-www
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# 3) Página 404 personalizada (redirecionando para a home já que é one page)
ErrorDocument 404 /index.html

# 4) Compressão gzip/deflate
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# 5) Cache de Navegador
<IfModule mod_expires.c>
    ExpiresActive On
    
    # HTML: 0 segundos (nunca fazer cache para forçar a atualização imediata)
    <FilesMatch "\.(html|htm)$">
        ExpiresDefault "access plus 0 seconds"
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </FilesMatch>
    
    # Imagens e Mídias (1 mês)
    <FilesMatch "\.(jpg|jpeg|png|webp|svg|gif|ico)$">
        ExpiresDefault "access plus 1 month"
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>
    
    # CSS e JS (1 semana)
    <FilesMatch "\.(css|js)$">
        ExpiresDefault "access plus 1 week"
        Header set Cache-Control "max-age=604800, public"
    </FilesMatch>
</IfModule>
